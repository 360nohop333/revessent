# ─── Revessent Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in every value before running.
# NEVER commit .env.local to git.

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database (Neon) ──────────────────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgres://username:password@ep-xxx.us-east-1.aws.neon.tech/revessent?sslmode=require
APP_DATABASE_URL=postgres://username:password@ep-xxx.us-east-1.aws.neon.tech/revessent?sslmode=require

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Password hashing (argon2id) — leave these as-is for production
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=4

# ─── Stripe (YOUR OWN Stripe account for billing Revessent customers) ─────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from: https://dashboard.stripe.com/webhooks (after creating endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → your database → REST URL
REDIS_URL=redis://default:password@us1-xxx.upstash.io:6379

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=Revessent <noreply@yourdomain.com>

# ─── AI (Anthropic) ───────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Encryption (for storing customer Stripe keys) ───────────────────────────
# Generate with: openssl rand -base64 32
KEY_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# ─── SMS recovery (Twilio) — Feature 3 ────────────────────────────────────────
# Get from: https://console.twilio.com (Account Info → API credentials)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ─── Cron (hourly recovery escalation ladder) — Feature 4 ─────────────────────
# Random secret the Vercel Cron job sends as `Authorization: Bearer <value>`.
# Generate with: openssl rand -hex 32
# Must match the CRON_SECRET env var set on the Vercel project.
CRON_SECRET=generate-with-openssl-rand-hex-32

# AI drafting model (optional, default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
