# ─── Revessent Environment Variables ─────────────────────────────────────────
# Set these in Vercel (Project → Settings → Environment Variables), NOT in a
# committed file. This list matches README.md — the README is the source of
# truth. (Audit #65: the old Next.js / Better Auth / Stripe values are gone;
# that stack is not what runs anymore.)

# ─── Database (Neon) — required ───────────────────────────────────────────────
# Neon console → your project → connection string. Prefer the -pooler endpoint.
DATABASE_URL=postgres://username:password@ep-xxx-pooler.us-east-1.aws.neon.tech/revessent?sslmode=require

# ─── Secrets — required ───────────────────────────────────────────────────────
# 64 hex chars. Encrypts Razorpay Key Secrets AND signs unsubscribe links.
# BACK THIS UP — losing it bricks saved Razorpay connections.
#   openssl rand -hex 32
ENCRYPTION_KEY=
# Presented by the Vercel cron on every run (Bearer). Generate like:
#   openssl rand -hex 32
CRON_SECRET=

# ─── Auth (Supabase) — recommended ────────────────────────────────────────────
# Defaults to the current project if unset; override to move projects.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# ─── Email + AI — optional ────────────────────────────────────────────────────
# Enables AI email/SMS drafting (Google AI Studio key).
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash.
GEMINI_MODEL=
# Enables email sending (Resend). Without it, notes are drafted but not sent.
RESEND_API_KEY=
# Fallback sender address when a workspace has no voice profile yet.
RESEND_FROM_EMAIL=hello@yourdomain.com

# ─── Links — optional ─────────────────────────────────────────────────────────
# Canonical base URL for unsubscribe links (defaults to the Vercel
# production URL of the deployment).
PUBLIC_APP_URL=https://revessent-alpha.vercel.app
